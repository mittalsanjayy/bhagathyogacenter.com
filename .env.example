# Copy to .env (or .env.local) for local development. NEVER commit the real file.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# Razorpay API keys (Dashboard -> Account & Settings -> API Keys). Keep both from the same mode.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# PostgreSQL connection string for permanent payment records.
# On Vercel, adding the Neon integration (Storage tab) injects this automatically.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
